PORT=8765
LICENSE_SERVICE_SECRET_KEY=change-this-session-secret
LICENSE_SERVICE_ADMIN_TOKEN=change-this-admin-token
LICENSE_SERVICE_MACHINE_CODE_SALT=change-this-machine-code-salt
LICENSE_SERVICE_ALLOWED_APPS=ControlCommand,E-Player,WinPilot,iCMS,rust-node
LICENSE_SERVICE_TRIAL_DAYS=30
# 内置接口限流（challenge 30/min、trial 5/min、latest 10/min，按 来源IP+接口 计数）；设 0 关闭
LICENSE_SERVICE_RATE_LIMIT=1
# Optional per-product caps, e.g. {"ControlCommand":365,"rust-node":90}
LICENSE_SERVICE_TRIAL_DAYS_MAP={}
LICENSE_SERVICE_DB_PATH=./data/license-service.db
# 私钥/公钥路径：统一 LICENSE_SERVICE_ 前缀；旧名 LICENSE_PRIVATE_KEY_PATH /
# LICENSE_PUBLIC_KEY_PATH 仍被识别，迁移后可删除
LICENSE_SERVICE_PRIVATE_KEY_PATH=./keys/ed25519-private.pem
LICENSE_SERVICE_PUBLIC_KEY_PATH=./keys/ed25519-public.pem
